[project]
name = {{ project_slug | tojson }}
version = "0.1.0"
description = {{ description | tojson }}
readme = "readme.md"
requires-python = ">={{ python_version }}"
authors = [{ name = {{ author_name | tojson }}, email = {{ author_email | tojson }} }]
{%- if license != 'none' %}
license = "{{ license }}"
license-files = ["LICENSE"]
{%- endif %}
keywords = []
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
{%- for v in ["3.12", "3.13", "3.14"] %}
{%- if v.split('.') | map('int') | list >= python_version.split('.') | map('int') | list %}
    "Programming Language :: Python :: {{ v }}",
{%- endif %}
{%- endfor %}
    "Typing :: Typed",
]
dependencies = [
{% include "template/_catalog_dependencies.jinja" %}
]

[project.urls]
Homepage = {{ ('https://github.com/' ~ github_username ~ '/' ~ github_repo) | tojson }}
Repository = {{ ('https://github.com/' ~ github_username ~ '/' ~ github_repo) | tojson }}
Issues = {{ ('https://github.com/' ~ github_username ~ '/' ~ github_repo ~ '/issues') | tojson }}
{%- if use_docs %}
Documentation = {{ ('https://' ~ github_username ~ '.github.io/' ~ github_repo) | tojson }}
{%- endif %}

{% if workload in ['cli', 'api', 'mcp', 'agent', 'rag', 'inference', 'training', 'hybrid'] or interfaces | default([]) -%}
[project.scripts]
{%- if workload == 'cli' %}
{{ project_slug }} = "{{ module_name }}.cli:app"
{%- elif workload == 'api' %}
{{ project_slug }} = "{{ module_name }}.api:main"
{%- elif workload == 'mcp' %}
{{ project_slug }} = "{{ module_name }}.mcp:main"
{%- elif workload == 'agent' %}
{{ project_slug }} = "{{ module_name }}.agent:main"
{%- elif workload == 'rag' %}
{{ project_slug }} = "{{ module_name }}.rag:main"
{%- elif workload == 'inference' %}
{{ project_slug }} = "{{ module_name }}.serving:main"
{%- elif workload == 'training' %}
{{ project_slug }} = "{{ module_name }}.training:main"
{%- elif workload == 'hybrid' %}
{{ project_slug }}-train = "{{ module_name }}.training:main"
{{ project_slug }}-serve = "{{ module_name }}.serving:main"
{%- endif %}
{%- if 'fastapi' in interfaces | default([]) %}
{{ project_slug }}-fastapi = "{{ module_name }}.interfaces.fastapi_app:main"
{%- endif %}
{%- if 'flask' in interfaces | default([]) %}
{{ project_slug }}-flask = "{{ module_name }}.interfaces.flask_app:main"
{%- endif %}
{%- for interface in interfaces | default([]) if interface in ['streamlit', 'gradio', 'textual', 'nicegui', 'fasthtml', 'violetear'] %}
{{ project_slug }}-{{ interface }} = "{{ module_name }}.interfaces.{{ interface }}_app:main"
{%- endfor %}

{% endif -%}
[build-system]
requires = ["uv_build>=0.12.1,<0.13"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = {{ module_name | tojson }}
module-root = "src"

{%- if workload == 'hybrid' %}
[tool.uv.workspace]
members = ["packages/*"]
{%- endif %}

[dependency-groups]
dev = [
    "deptry>=0.25.1",
    "poethepoet>=0.48.0",
    "pre-commit>=4.6.1",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
{%- if framework == 'fastapi' or 'fastapi' in interfaces | default([]) %}
    "httpx>=0.28.1",
{%- endif %}
    "ruff>=0.16.2",
    # ty is still 0.0.x; CI runs it non-blocking until it reaches 1.0.
    "ty>=0.0.69",
]
{%- if use_docs %}
docs = [
    "mkdocstrings[python]>=1.0.6",
    "zensical>=0.0.53",
]
{%- endif %}

# ------------------------------------------------------------------- tasks --
# Run with `uv run poe <task>`, e.g. `uv run poe check`.

[tool.poe.tasks]
lint = { cmd = "ruff check .", help = "Lint the code" }
fix = { cmd = "ruff check --fix .", help = "Lint and apply safe fixes" }
format = { cmd = "ruff format .", help = "Format the code" }
format-check = { cmd = "ruff format --check .", help = "Check formatting" }
# Advisory while ty is pre-1.0, so a finding here must not fail `poe check`.
types = { cmd = "ty check", help = "Type check (advisory)" }
deps = { cmd = "deptry src", help = "Check for unused and undeclared dependencies" }
test = { cmd = "pytest", help = "Run the tests" }
cov = { cmd = "pytest --cov --cov-report=term-missing", help = "Run the tests with coverage" }
{%- if use_docs %}
docs = { cmd = "zensical serve", help = "Preview the documentation" }
docs-build = { cmd = "zensical build", help = "Build the documentation" }
{%- endif %}
check = { sequence = ["lint", "format-check", "deps", "cov"], help = "Run everything CI runs (except the advisory type check)" }

# ------------------------------------------------------------------- ruff --
# Replaces flake8, black, isort and pyupgrade with a single tool.

[tool.ruff]
line-length = 88
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "W",    # pycodestyle warnings
    "F",    # pyflakes
    "I",    # isort
    "B",    # flake8-bugbear
    "C4",   # flake8-comprehensions
    "UP",   # pyupgrade
    "ARG",  # flake8-unused-arguments
    "SIM",  # flake8-simplify
    "PTH",  # flake8-use-pathlib
    "RUF",  # ruff-specific rules
]
ignore = [
    "E501",  # line length is handled by the formatter
]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["ARG"]

[tool.ruff.format]
docstring-code-format = true

# --------------------------------------------------------------------- ty --
# Astral's type checker. Still pre-1.0, so CI runs it non-blocking for now.

[tool.ty.environment]
python-version = "{{ python_version }}"
root = ["./src"]

[tool.ty.src]
include = ["src", "tests"]

# ----------------------------------------------------------------- pytest --

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--strict-markers --strict-config"

# --------------------------------------------------------------- coverage --
# Replaces the old .coveragerc file.

[tool.coverage.run]
source = ["src"]
branch = true

[tool.coverage.report]
fail_under = 95
precision = 1
show_missing = true
skip_covered = true
exclude_also = [
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
]

# ----------------------------------------------------------------- deptry --

[tool.deptry]
known_first_party = [{{ module_name | tojson }}]
{%- if deploy_target != 'none' and (framework == 'flask' or primary_interface == 'flask') %}
# Gunicorn is a process entrypoint referenced by Docker, not imported by Python.
per_rule_ignores = { DEP002 = ["gunicorn"] }
{%- endif %}
