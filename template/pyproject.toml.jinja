[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "readme.md"
requires-python = ">={{ python_version }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
{%- if license != 'none' %}
license = "{{ license }}"
license-files = ["LICENSE"]
{%- endif %}
keywords = []
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
{%- for v in ["3.11", "3.12", "3.13", "3.14"] %}
{%- if v.split('.') | map('int') | list >= python_version.split('.') | map('int') | list %}
    "Programming Language :: Python :: {{ v }}",
{%- endif %}
{%- endfor %}
    "Typing :: Typed",
]
dependencies = [
{%- if project_type == 'cli' %}
    "typer>=0.27.1",
{%- elif project_type == 'api' %}
    "fastapi[standard]>=0.141.1",
    # Imported directly by the app, so declared directly rather than relying
    # on it being a transitive dependency of FastAPI.
    "pydantic>=2.13.4",
{%- endif %}
]

[project.urls]
Homepage = "https://github.com/{{ github_username }}/{{ github_repo }}"
Repository = "https://github.com/{{ github_username }}/{{ github_repo }}"
Issues = "https://github.com/{{ github_username }}/{{ github_repo }}/issues"
{%- if use_docs %}
Documentation = "https://{{ github_username }}.github.io/{{ github_repo }}"
{%- endif %}

{% if project_type == 'cli' -%}
[project.scripts]
{{ project_slug }} = "{{ module_name }}.cli:app"

{% endif -%}
[build-system]
requires = ["uv_build>=0.12,<0.13"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ module_name }}"
module-root = "src"

[dependency-groups]
dev = [
    "deptry>=0.25.1",
    "poethepoet>=0.48.0",
    "pre-commit>=4.6.1",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
{%- if project_type == 'api' %}
    "httpx>=0.28.1",
{%- endif %}
    "ruff>=0.16.2",
    # ty is still 0.0.x; CI runs it non-blocking until it reaches 1.0.
    "ty>=0.0.69",
]
{%- if use_docs %}
docs = [
    "mkdocstrings[python]>=1.0.6",
    "zensical>=0.0.53",
]
{%- endif %}

# ------------------------------------------------------------------- tasks --
# Run with `uv run poe <task>`, e.g. `uv run poe check`.

[tool.poe.tasks]
lint = { cmd = "ruff check .", help = "Lint the code" }
fix = { cmd = "ruff check --fix .", help = "Lint and apply safe fixes" }
format = { cmd = "ruff format .", help = "Format the code" }
format-check = { cmd = "ruff format --check .", help = "Check formatting" }
# Advisory while ty is pre-1.0, so a finding here must not fail `poe check`.
types = { cmd = "ty check", help = "Type check (advisory)" }
deps = { cmd = "deptry src", help = "Check for unused and undeclared dependencies" }
test = { cmd = "pytest", help = "Run the tests" }
cov = { cmd = "pytest --cov --cov-report=term-missing", help = "Run the tests with coverage" }
{%- if use_docs %}
docs = { cmd = "zensical serve", help = "Preview the documentation" }
docs-build = { cmd = "zensical build", help = "Build the documentation" }
{%- endif %}
check = { sequence = ["lint", "format-check", "deps", "test"], help = "Run everything CI runs (except the advisory type check)" }

# ------------------------------------------------------------------- ruff --
# Replaces flake8, black, isort and pyupgrade with a single tool.

[tool.ruff]
line-length = 88
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "W",    # pycodestyle warnings
    "F",    # pyflakes
    "I",    # isort
    "B",    # flake8-bugbear
    "C4",   # flake8-comprehensions
    "UP",   # pyupgrade
    "ARG",  # flake8-unused-arguments
    "SIM",  # flake8-simplify
    "PTH",  # flake8-use-pathlib
    "RUF",  # ruff-specific rules
]
ignore = [
    "E501",  # line length is handled by the formatter
]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["ARG"]

[tool.ruff.format]
docstring-code-format = true

# --------------------------------------------------------------------- ty --
# Astral's type checker. Still pre-1.0, so CI runs it non-blocking for now.

[tool.ty.environment]
python-version = "{{ python_version }}"
root = ["./src"]

[tool.ty.src]
include = ["src", "tests"]

# ----------------------------------------------------------------- pytest --

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--strict-markers --strict-config"

# --------------------------------------------------------------- coverage --
# Replaces the old .coveragerc file.

[tool.coverage.run]
source = ["src"]
branch = true

[tool.coverage.report]
exclude_also = [
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
]

# ----------------------------------------------------------------- deptry --

[tool.deptry]
known_first_party = ["{{ module_name }}"]
