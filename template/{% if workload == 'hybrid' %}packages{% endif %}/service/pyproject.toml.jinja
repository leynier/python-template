[project]
name = "{{ project_slug }}-service"
version = "0.1.0"
requires-python = ">={{ python_version }}"
dependencies = ["{{ project_slug }}"]

[tool.uv.sources]
"{{ project_slug }}" = { workspace = true }

[build-system]
requires = ["uv_build>=0.12.1,<0.13"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ module_name }}_service"
module-root = "src"
