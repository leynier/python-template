"""Flask interface for the configured AI workload."""

{% if auth != 'none' -%}
from collections.abc import Callable
from functools import wraps
from typing import Any, cast

{%- endif %}
from flask import Flask, jsonify, request

# isort: split
{% if auth != 'none' -%}
from {{ module_name }} import auth as auth_backend
{%- endif %}
{% if workload == 'agent' -%}
from {{ module_name }}.agent import build_agent
{%- else -%}
from {{ module_name }}.rag import build_rag
{%- endif %}
app = Flask(__name__)
{% if auth != 'none' %}

def authenticated[F: Callable[..., Any]](view: F) -> F:
    """Protect a Flask view with the configured authentication backend."""

    @wraps(view)
    def wrapper(*args: Any, **kwargs: Any) -> Any:
        try:
            auth_backend.authenticate_request(
                api_key=request.headers.get("X-API-Key"),
                authorization=request.headers.get("Authorization"),
            )
        except auth_backend.AuthenticationError as error:
            return jsonify(detail=str(error)), 401
        return view(*args, **kwargs)

    return cast(F, wrapper)
{% endif %}

@app.get("/health")
def health():  # type: ignore[no-untyped-def]
    """Report service health."""
    return jsonify(status="ok")


@app.post("/run")
{% if auth != 'none' -%}
@authenticated
{%- endif %}
def run():  # type: ignore[no-untyped-def]
    """Run the configured local agent or retriever."""
    text = str((request.get_json(silent=True) or {}).get("text", ""))
    {% if workload == 'agent' -%}
    output = build_agent().run(text)
    {%- else -%}
    output = build_rag().query(text)
    {%- endif %}
    return jsonify(output=output)


def main() -> None:
    """Run the WSGI application."""
    app.run(host="0.0.0.0", port=8000)
