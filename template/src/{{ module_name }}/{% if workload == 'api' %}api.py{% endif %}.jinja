{% if framework == 'fastapi' -%}
"""FastAPI application."""

{% if auth != 'none' -%}
from typing import Annotated

from fastapi import Depends, FastAPI, Header, HTTPException
{%- else -%}
from fastapi import FastAPI
{%- endif %}
from pydantic import BaseModel

# isort: split
{% if auth != 'none' -%}
from {{ module_name }} import auth as auth_backend
{%- endif %}

app = FastAPI(
    title={{ project_name | tojson }},
    description={{ (description or project_name) | tojson }},
    version="0.1.0",
)


class Health(BaseModel):
    """Service health payload."""

    status: str


class Greeting(BaseModel):
    """Greeting payload."""

    message: str
{% if auth != 'none' %}

async def require_authenticated(
    x_api_key: Annotated[str | None, Header(alias="X-API-Key")] = None,
    authorization: Annotated[str | None, Header()] = None,
) -> str:
    """Authenticate one request through the selected backend."""
    try:
        return auth_backend.authenticate_request(
            api_key=x_api_key,
            authorization=authorization,
        )
    except auth_backend.AuthenticationError as error:
        raise HTTPException(
            status_code=401,
            detail=str(error),
            headers={"WWW-Authenticate": "Bearer"},
        ) from error
{% endif %}

@app.get("/health", tags=["system"])
async def health() -> Health:
    """Report service health."""
    return Health(status="ok")


@app.get(
    "/greet/{name}",
    tags=["greeting"],
{%- if auth != 'none' %}
    dependencies=[Depends(require_authenticated)],
{%- endif %}
)
async def greet(name: str) -> Greeting:
    """Greet the given name."""
    return Greeting(message=f"Hello, {name}!")


def main() -> None:
    """Run the ASGI application."""
    import uvicorn

    uvicorn.run(app, host="0.0.0.0", port=8000)
{%- elif framework == 'flask' -%}
"""Flask application."""

{% if auth != 'none' -%}
from collections.abc import Callable
from functools import wraps
from typing import Any, cast

from flask import Flask, jsonify, request

# isort: split
from {{ module_name }} import auth as auth_backend

{%- else -%}
from flask import Flask, jsonify
{%- endif %}

app = Flask(__name__)
{% if auth != 'none' %}

def authenticated[F: Callable[..., Any]](view: F) -> F:
    """Protect a Flask view with the configured authentication backend."""

    @wraps(view)
    def wrapper(*args: Any, **kwargs: Any) -> Any:
        try:
            auth_backend.authenticate_request(
                api_key=request.headers.get("X-API-Key"),
                authorization=request.headers.get("Authorization"),
            )
        except auth_backend.AuthenticationError as error:
            return jsonify(detail=str(error)), 401
        return view(*args, **kwargs)

    return cast(F, wrapper)
{% endif %}

@app.get("/health")
def health():  # type: ignore[no-untyped-def]
    """Report service health."""
    return jsonify(status="ok")


@app.get("/greet/<name>")
{% if auth != 'none' -%}
@authenticated
{%- endif %}
def greet(name: str):  # type: ignore[no-untyped-def]
    """Greet the given name."""
    return jsonify(message=f"Hello, {name}!")


def main() -> None:
    """Run the development WSGI server."""
    app.run(host="0.0.0.0", port=8000)
{%- endif %}
