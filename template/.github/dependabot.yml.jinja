version: 2
updates:
  # Python dependencies, resolved through uv.lock.
  - package-ecosystem: "uv"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      python-dev:
        dependency-type: "development"

  # Keeps the SHA-pinned actions in .github/workflows up to date.
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      actions:
        patterns: ["*"]
{% if use_docker %}
  - package-ecosystem: "docker"
    directory: "/"
    schedule:
      interval: "weekly"
{%- endif %}
{%- if use_devcontainer %}

  - package-ecosystem: "devcontainers"
    directory: "/"
    schedule:
      interval: "weekly"
{%- endif %}
