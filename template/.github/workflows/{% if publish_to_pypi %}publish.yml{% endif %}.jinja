name: Publish

on:
  push:
    tags: ["v*.*.*"]

permissions:
  contents: read

jobs:
  build:
    name: Build distributions
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7.0.1
        with:
          persist-credentials: false

      - name: Set up uv
        uses: astral-sh/setup-uv@v9.0.0
        with:
          python-version: "{{ python_version }}"
          # Caching is deliberately disabled here. This job produces the
          # artifacts that get published, and a poisoned cache entry could
          # end up inside them. The few seconds saved are not worth it.
          enable-cache: false

      - name: Verify the tag matches the project version
        run: |
          tag="{% raw %}${GITHUB_REF#refs/tags/v}{% endraw %}"
          version="$(uv version --short)"
          if [ "$tag" != "$version" ]; then
            echo "::error::Tag v$tag does not match project version $version"
            exit 1
          fi

      - name: Build
        run: uv build

      - name: Check metadata
        run: uvx twine check dist/*

      - uses: actions/upload-artifact@v7.0.1
        with:
          name: dist
          path: dist/

  pypi:
    name: Publish to PyPI
    needs: build
    runs-on: ubuntu-latest
    # Trusted Publishing: no API token, no secrets. Configure the publisher at
    # https://pypi.org/manage/account/publishing/ before the first release.
    environment:
      name: pypi
      url: https://pypi.org/p/{{ project_slug }}
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@v8.0.1
        with:
          name: dist
          path: dist/

      # Sigstore attestations are generated and uploaded by default.
      - uses: pypa/gh-action-pypi-publish@v1.14.2

  release:
    name: Create GitHub release
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v8.0.1
        with:
          name: dist
          path: dist/

      - name: Publish release
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}

          TAG: {% raw %}${{ github.ref_name }}{% endraw %}

          REPO: {% raw %}${{ github.repository }}{% endraw %}

        run: |
          gh release create "$TAG" dist/* \
            --repo "$REPO" \
            --title "$TAG" \
            --generate-notes
