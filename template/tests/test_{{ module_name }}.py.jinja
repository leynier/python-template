{%- elif workload == 'rag' -%}
"""Offline tests for the {{ module_name }} RAG application."""

from {{ module_name }}.rag import build_rag, main


def test_rag_retrieves_locally_without_credentials() -> None:
    rag = build_rag()
    assert rag.query("nothing") == "No documents indexed."
    rag.add("Python projects are composable.", "Bananas are yellow.")
    assert rag.query("Are Python projects composable?") == (
        "Python projects are composable."
    )


def test_rag_main(capsys) -> None:  # type: ignore[no-untyped-def]
    main()
    assert "{{ project_name }}" in capsys.readouterr().out
