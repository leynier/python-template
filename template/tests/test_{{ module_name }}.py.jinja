"""Tests for the {{ module_name }} Flask API."""

from {{ module_name }} import api as api_module
{% if auth != 'none' -%}
from {{ module_name }} import auth as auth_backend
{% endif -%}
from {{ module_name }}.api import app


def test_health() -> None:
    response = app.test_client().get("/health")
    assert response.status_code == 200
    assert response.get_json() == {"status": "ok"}


def test_greet({% if auth != 'none' %}monkeypatch{% endif %}) -> None:  # type: ignore[no-untyped-def]
{%- if auth != 'none' %}
    denied = app.test_client().get("/greet/world")
    assert denied.status_code == 401
    monkeypatch.setattr(
        auth_backend,
        "authenticate_request",
        lambda **_credentials: "test-user",
    )
{%- endif %}
    response = app.test_client().get("/greet/world")
    assert response.status_code == 200
    assert response.get_json() == {"message": "Hello, world!"}


def test_main_starts_flask(monkeypatch) -> None:  # type: ignore[no-untyped-def]
    started: dict[str, object] = {}
    monkeypatch.setattr(app, "run", lambda **options: started.update(options))

    api_module.main()

    assert started == {"host": "0.0.0.0", "port": 8000}
